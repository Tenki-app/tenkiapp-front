{
    "compilerOptions": {
        "target": "es5",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/UI/*": [
                "./src/UI/*"
            ],
            "@/lib/*": [
                "./src/lib/*"
            ],
            "@/pages/*": [
                "./src/pages/*"
            ],
            "@/helpers/*": [
                "./src/lib/helpers/*"
            ],
            "@/hooks/*": [
                "./src/lib/hooks/*"
            ],
            "@/styles/*": [
                "./src/styles/*"
            ],
            "@/svg/*": [
                "./src/assets/svg/*"
            ],
            "@/images/*": [
                "./src/assets/images/*"
            ],
            "@/store/*": [
                "./src/UI/lib/store*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}